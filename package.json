{
  "name": "twenty-mcp-server",
  "version": "0.3.0",
  "description": "MCP Server for Twenty CRM with dynamic tool discovery",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "twenty-mcp-server": "build/index.js"
  },
  "files": [
    "build"
  ],
  "keywords": ["mcp", "twenty", "crm", "ai", "claude", "anthropic"],
  "author": "Tim Schauder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jdu278/twenty-mcp-server"
  },
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc && chmod 755 build/index.js && cp -r src/instructions build/",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "axios": "^1.9.0",
    "dotenv": "^16.4.5",
    "json-schema-to-zod": "^2.6.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "typescript": "^5.8.3"
  }
}
