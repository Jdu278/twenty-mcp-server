{
  "name": "twenty-mcp-server",
  "version": "0.4.0",
  "description": "MCP Server for Twenty CRM with dynamic tool discovery",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "twenty-mcp-server": "build/index.js"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "twenty",
    "crm",
    "ai",
    "claude",
    "anthropic"
  ],
  "author": "Tim Schauder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jdu278/twenty-mcp-server"
  },
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc && chmod 755 build/index.js && cp -r src/instructions build/",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "json-schema-to-zod": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
